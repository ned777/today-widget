<?xml version="1.0" encoding="utf-8"?>
<!--
  Full month calendar-grid widget. Same refresh strategy as
  date_widget_info.xml — see the comment there. minResizeWidth/Height match
  the date widget's own minimum (90dp) so this can be shrunk down just as
  small after placement, even though its default placed size is bigger.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="90dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_month"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
