        <TextView android:id="@+id/header_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
