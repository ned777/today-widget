<?xml version="1.0" encoding="utf-8"?>
<!--
  The small "glance at today" widget — an iOS-calendar-icon-style square:
  a big day-of-month number on top, weekday + month below it. All three
  TextViews' text (and dayText's size — see DateWidgetProvider.kt) are set
  in code; nothing here ever changes except through that.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dateWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_outline_background"
    android:padding="0dp">

    <!--
      textSize here is just a placeholder shown for the instant before
      DateWidgetProvider.kt's first update — every real update overrides it
      via RemoteViews.setTextViewTextSize() so the number's rendered width
      always matches headerRow's rendered width below it.
    -->
    <TextView
        android:id="@+id/dayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/retro_cyan"
        android:textSize="90sp"
        android:textStyle="bold"
        android:shadowColor="@color/retro_cyan"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="14"
        android:text="--" />

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/weekdayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_teal"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:shadowColor="@color/retro_teal"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:text="--" />

        <TextView
            android:layout_width="4dp"
            android:layout_height="wrap_content"
            android:text="" />

        <TextView
            android:id="@+id/monthText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:text="--" />

    </LinearLayout>

</LinearLayout>
