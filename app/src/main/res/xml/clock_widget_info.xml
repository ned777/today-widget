<?xml version="1.0" encoding="utf-8"?>
<!--
  Round retro clock widget. Unlike the date/month widgets (which only need to
  notice midnight rolling over), a clock needs to visibly tick every minute —
  see ClockTickReceiver.kt for how that's driven by a self-rescheduling
  AlarmManager chain rather than this updatePeriodMillis, which stays as
  just a 30-minute safety net in case that chain is ever lost (e.g. a very
  aggressive battery optimizer).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="130dp"
    android:minHeight="130dp"
    android:minResizeWidth="90dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_clock"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
