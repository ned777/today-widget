<?xml version="1.0" encoding="utf-8"?>
<!--
  The round retro clock widget: a circle with just two big stacked
  double-digit numbers inside, hour on top and minutes below — no colon, no
  seconds, no date. Both TextViews' text is set in code by
  ClockWidgetProvider.kt.

  The circle card is a FIXED-size inner view (130dp, matching this widget's
  minWidth/minHeight in clock_widget_info.xml) centered inside a match_parent
  FrameLayout, rather than a background that stretches to fill whatever
  bounds the launcher hands us — home-screen grid cells usually aren't
  perfectly square, so an oval shape that stretches to fill a non-square
  view draws as an egg, not a circle. Keeping the circle itself fixed-size
  guarantees it stays round regardless of the launcher's actual cell
  proportions; the click target still covers the full outer bounds so the
  tappable area doesn't shrink along with it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clockWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_circle_background">

        <TextView
            android:id="@+id/hourText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_white"
            android:textSize="52sp"
            android:textStyle="bold"
            android:shadowColor="@color/retro_white"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:text="--" />

        <TextView
            android:id="@+id/minuteText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:textColor="@color/retro_cyan"
            android:textSize="52sp"
            android:textStyle="bold"
            android:shadowColor="@color/retro_cyan"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12"
            android:text="--" />

    </LinearLayout>

</FrameLayout>
