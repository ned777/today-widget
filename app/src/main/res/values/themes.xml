<!--
  Theme.TodayWidget: a plain (non-DayNight) dark theme so the app always looks
  the same retro way regardless of the phone's system dark-mode setting.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TodayWidget" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/retro_teal</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/retro_cyan</item>
        <item name="android:windowBackground">@color/widget_bg</item>
        <item name="android:textColorPrimary">@color/retro_white</item>
        <item name="android:textColorSecondary">@color/retro_white</item>
    </style>
</resources>
