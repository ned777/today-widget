<?xml version="1.0" encoding="utf-8"?>
<!--
  Same flat dark card as widget_outline_background.xml, but with a cyan
  outline instead of yellow — the month-grid widget's own accent, kept
  visually distinct from the small daily date widget's yellow border.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/retro_cyan" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
</layer-list>
