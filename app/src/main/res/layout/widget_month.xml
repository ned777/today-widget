<?xml version="1.0" encoding="utf-8"?>
<!--
  The larger month-grid widget: current month only, no navigation (there's
  nothing to tap to change months — the whole point is it always shows
  "now"). A month title, a row of weekday-abbreviation headers, then a fixed
  6x7 grid of day cells. The grid is fully static XML rather than a
  RemoteViewsService-backed list — a calendar month is always exactly 6 rows
  of 7 columns, so there's nothing dynamic about its SHAPE, only its
  contents, which MonthWidgetProvider.kt fills in (and blanks out any cells
  that fall outside the current month) every time it redraws.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monthWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_outline_background"
    android:paddingTop="10dp"
    android:paddingBottom="8dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/monthTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/retro_white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:letterSpacing="0.04"
        android:layout_marginBottom="6dp"
        android:text="--" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">
        <TextView android:id="@+id/header_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
        <TextView android:id="@+id/header_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
