<?xml version="1.0" encoding="utf-8"?>
<!--
  Round background for the clock widget: same dark-card-with-yellow-outline
  retro look as widget_outline_background.xml, just drawn as a true circle
  (oval shape, sized off a square widget) instead of a rounded rectangle.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/retro_yellow" />
        </shape>
    </item>
</layer-list>
