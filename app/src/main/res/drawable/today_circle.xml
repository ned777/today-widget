<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid cyan circle painted behind today's number in the month grid widget —
  the iOS-style "you are here" highlight. Applied per-cell in code
  (MonthWidgetProvider.kt) only to whichever TextView is today, via
  RemoteViews.setInt(id, "setBackgroundResource", R.drawable.today_circle).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/retro_cyan" />
</shape>
