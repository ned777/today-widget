<?xml version="1.0" encoding="utf-8"?>
<!--
  Full month calendar-grid widget. Same refresh strategy as
  date_widget_info.xml — see the comment there. Capped at a 2x2 footprint —
  same default AND max size as the date widget itself (maxResizeWidth/Height,
  API 31+; ignored on older platforms, which just fall back to whatever
  minWidth/minHeight/targetCellWidth/Height already say) — minResizeWidth/
  Height still allow shrinking smaller than that if wanted.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="90dp"
    android:minResizeHeight="90dp"
    android:maxResizeWidth="110dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_month"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
