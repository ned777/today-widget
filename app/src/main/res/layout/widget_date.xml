<?xml version="1.0" encoding="utf-8"?>
<!--
  The small "glance at today" widget — an iOS-calendar-icon-style square:
  weekday + month on one line, a big day-of-month number below. All three
  TextViews' text is set in code by DateWidgetProvider.kt; nothing here ever
  changes except through that.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dateWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_outline_background"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/weekdayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_teal"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:shadowColor="@color/retro_teal"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:text="--" />

        <TextView
            android:layout_width="4dp"
            android:layout_height="wrap_content"
            android:text="" />

        <TextView
            android:id="@+id/monthText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:text="--" />

    </LinearLayout>

    <TextView
        android:id="@+id/dayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/retro_pink"
        android:textSize="44sp"
        android:textStyle="bold"
        android:shadowColor="@color/retro_pink"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:text="--" />

</LinearLayout>
