<?xml version="1.0" encoding="utf-8"?>
<!--
  The round retro clock widget: a circle with just two big stacked
  double-digit numbers inside, hour on top and minutes below — no colon, no
  seconds, no date. Both TextViews' text is set in code by
  ClockWidgetProvider.kt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clockWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_circle_background"
    android:padding="8dp">

    <TextView
        android:id="@+id/hourText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/retro_white"
        android:textSize="36sp"
        android:textStyle="bold"
        android:shadowColor="@color/retro_white"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        android:text="--" />

    <TextView
        android:id="@+id/minuteText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:textColor="@color/retro_cyan"
        android:textSize="36sp"
        android:textStyle="bold"
        android:shadowColor="@color/retro_cyan"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:text="--" />

</LinearLayout>
