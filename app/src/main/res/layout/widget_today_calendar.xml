<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4x2 "Today + Calendar" widget: the Today Clock and the month grid side
  by side. Left: today's day number (cyan) with the full weekday under it
  (teal), the weekday's text size computed in code so it's exactly as wide as
  the number (see TodayCalendarWidgetProvider). Right: the same month grid as
  the Today Calendar widget, using the same view ids so
  MonthWidgetProvider.bindMonth() fills both widgets with one piece of code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comboWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/widget_outline_background_r26_inset"
    android:paddingTop="14dp"
    android:paddingBottom="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="16dp">

    <!-- LEFT: day number + full weekday, centered in its half. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.85"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/comboDayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/retro_cyan"
            android:textSize="84sp"
            android:textStyle="bold"
            android:text="--" />

        <TextView
            android:id="@+id/comboWeekdayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textColor="@color/retro_teal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:singleLine="true"
            android:text="--" />
    </LinearLayout>

    <!-- Thin teal divider between the two halves. -->
    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp"
        android:background="@color/retro_teal_dim" />

    <!-- RIGHT: the month grid (same ids as widget_month.xml). -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical">

            <TextView
                android:id="@+id/monthTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:letterSpacing="0.04"
                android:layout_marginBottom="6dp"
                android:text="--" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">
                <TextView android:id="@+id/header_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
                <TextView android:id="@+id/header_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
                <TextView android:id="@+id/header_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
                <TextView android:id="@+id/header_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
                <TextView android:id="@+id/header_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
                <TextView android:id="@+id/header_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
                <TextView android:id="@+id/header_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_teal" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.05" android:text="--" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/cell_0_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/retro_white" android:textSize="13sp" android:text="" />
